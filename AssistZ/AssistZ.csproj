<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- ILGPU compiles kernels from IL at run time: keep the IL if this app is ever AOT-compiled. -->
    <WasmStripILAfterAOT>false</WasmStripILAfterAOT>
  </PropertyGroup>

  <!-- Build timestamp, printed to the console at startup so a stale build is obvious. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildTimestamp</_Parameter1>
      <_Parameter2>$([System.DateTime]::UtcNow.ToString("yyyy-MM-dd HH:mm:ss")) UTC</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.14" PrivateAssets="all" />
    <!-- SpawnJS pinned to the version SpawnDev.ILGPU.ML requires so the graph does not resolve two. -->
    <PackageReference Include="SpawnDev.SpawnJS" Version="3.0.8" />
    <PackageReference Include="SpawnDev.SpawnJS.Blazor" Version="3.0.7" />
    <PackageReference Include="SpawnDev.ILGPU.ML" Version="5.8.5" />
    <!-- 5.4.15: the canvas renderers size the attached canvas to the frame (ML local.15 alone would resolve 5.4.15-local.5). -->
    <PackageReference Include="SpawnDev.ILGPU" Version="5.4.16" />
  </ItemGroup>

  <!-- Kept whole by the trimmer: ILGPU reads IL and reflects in its static constructors; kernels are reached through delegates. -->
  <ItemGroup>
    <TrimmerRootAssembly Include="ILGPU" />
    <TrimmerRootAssembly Include="ILGPU.Algorithms" />
    <TrimmerRootAssembly Include="SpawnDev.ILGPU" />
    <TrimmerRootAssembly Include="AssistZ" />
  </ItemGroup>

</Project>
